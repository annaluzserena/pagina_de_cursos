# RutaLibre — variables de entorno de ejemplo
# Copiar a .env y reemplazar los valores de ejemplo. Nunca guardar credenciales reales en Git.
# Mantener estos nombres sincronizados con backend, frontend y compose.yaml al implementar.

# Aplicación / FastAPI
APP_NAME=RutaLibre
APP_ENV=development
DEBUG=true
API_HOST=0.0.0.0
API_PORT=8000
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173
APP_SECRET_KEY=replace-with-a-random-secret-at-least-32-bytes

# Sesiones (Secure=false solo para desarrollo local HTTP; producción debe usar HTTPS)
SESSION_COOKIE_NAME=rutalibre_session
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE=lax
SESSION_TTL_MINUTES=10080

# PostgreSQL 18.6 / Docker Compose
POSTGRES_DB=rutalibre
POSTGRES_USER=rutalibre
POSTGRES_PASSWORD=replace-with-a-local-development-password
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://rutalibre:replace-with-a-local-development-password@db:5432/rutalibre

# Frontend Vite: no poner secretos en variables VITE_*
VITE_APP_NAME=RutaLibre
VITE_API_PROXY_TARGET=http://localhost:8000
VITE_API_BASE_URL=http://localhost:8000/api/v1

# SMTP para recuperación de contraseña (Mailpit en desarrollo local)
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@rutalibre.local
SMTP_FROM_NAME=RutaLibre
SMTP_USE_TLS=false
SMTP_USE_SSL=false
PASSWORD_RESET_TOKEN_TTL_MINUTES=30
PASSWORD_RESET_FRONTEND_URL=http://localhost:5173/reset-password

# Rate limiting: valores iniciales definidos en TRD
LOGIN_MAX_FAILURES_PER_IDENTIFIER=5
LOGIN_IDENTIFIER_WINDOW_MINUTES=15
LOGIN_MAX_FAILURES_PER_IP=20
LOGIN_IP_WINDOW_MINUTES=15
AUTH_MAX_REQUESTS_PER_IP=5
AUTH_REQUEST_WINDOW_MINUTES=15

# Paginación
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# Migraciones / datos de ejemplo
RUN_MIGRATIONS=false
SEED_DEMO_DATA=false

# Base de datos de pruebas (ajustar al servicio/puerto usado en tests)
TEST_DATABASE_URL=postgresql+psycopg://rutalibre:replace-with-a-test-password@localhost:5433/rutalibre_test
