      "name": "01 — Autenticación",
      "item": [
        {
          "name": "Registrar usuario",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{userEmail}}\",\n  \"password\": \"{{userPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Respuesta exitosa\", () => pm.expect(pm.response.code).to.be.oneOf([200, 201]));",
                  "let j = {}; try { j = pm.response.json(); } catch(e) {}",
                  "const u = j.user || j.data?.user || j;",
                  "if (u.id) pm.collectionVariables.set(\"userId\", u.id);",
                  "if (u.email) pm.collectionVariables.set(\"registeredEmail\", u.email);"
                ]
              }
            }
          ]
